# Teaching diagnosis for the five-net circuit in the stuck-at exercise.
# The observation set is hypothetical; this is not physical failure analysis.
set here [file dirname [file normalize [info script]]]
source [file join $here .. lab4_fault_atpg_flow lab4_1_fault_atpg_run exhaustive_stuck_at.tcl]
set mode [expr {$argc ? [lindex $argv 0] : "normal"}]
if {$mode ni {normal inconsistent}} {error "Expected normal or inconsistent"}
# Responses generated by a hypothetical n stuck-at-0 defect.
set observations {000 0 001 1 010 0 011 1 100 0 101 1 110 0 111 1}
if {$mode eq "inconsistent"} {lset observations 1 1}
set candidates {}
foreach site {a b c n y} {
    foreach stuck {0 1} {
        set matches 1
        foreach {pattern measured} $observations {
            scan $pattern %1d%1d%1d a b c
            if {[circuit $a $b $c $site $stuck] != $measured} {set matches 0; break}
        }
        if {$matches} {lappend candidates "$site/$stuck"}
    }
}
if {![llength $candidates]} {
    puts "No single modeled fault explains all observations."
    exit 1
}
puts "Candidates: [join $candidates {, }]"
puts "Equivalent candidates cannot be separated by these observations."
